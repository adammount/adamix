# ============================================================
#  PRODUCTION .env (корень монорепо) — используется docker-compose.yml
#  Скопируй в .env и заполни значения: cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=adamix

# --- Backend ---
# Секрет для подписи JWT
JWT_SECRET=change_me_jwt_secret
# Публичный URL фронтенда — нужен backend для CORS
CLIENT_URL=https://adamics.uk
# Публичный URL backend — для ссылок в письмах (верификация почты)
API_URL=https://api.adamics.uk

# reCAPTCHA (серверный ключ)
RECAPTCHA_SECRET_KEY=

# SMTP (Mailgun и т.п.)
SMTP_PASSWORD=
SMTP_SERVER=smtp.mailgun.org
SMTP_LOGIN=

# --- Frontend ---
# Публичный адрес самого сайта
NEXT_PUBLIC_SITE_URL=https://adamics.uk
# Публичный адрес API backend (как его видит браузер пользователя), c /api на конце
NEXT_PUBLIC_API_URL=https://api.adamics.uk/api
# reCAPTCHA (публичный ключ сайта)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
