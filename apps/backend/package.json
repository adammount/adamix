{
	"name": "@adamix/backend",
	"version": "1.0.0",
	"description": "Adamix backend (NestJS)",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "prisma generate && nest build && node -e \"require('fs').cpSync('src/generated','dist/src/generated',{recursive:true})\"",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "node dist/src/main",
		"predev": "prisma generate && node -e \"require('fs').cpSync('src/generated','dist/src/generated',{recursive:true})\"",
		"dev": "nest start --watch",
		"debug": "nest start --debug --watch",
		"prod": "node dist/src/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"prisma:generate": "prisma generate",
		"prisma:deploy": "prisma migrate deploy",
		"db:reset": "prisma db push --force-reset --accept-data-loss",
		"seed:run": "ts-node -r tsconfig-paths/register --transpile-only ./seeder/seeder.ts",
		"seed:prod": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./seeder/seeder.ts"
	},
	"dependencies": {
		"@faker-js/faker": "^10.5.0",
		"@nestjs-modules/mailer": "^2.3.7",
		"@nestjs/common": "^11.1.27",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.27",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.1.27",
		"@nestjs/serve-static": "^5.0.5",
		"@nestlab/google-recaptcha": "^3.11.2",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@react-email/components": "^1.0.12",
		"argon2": "^0.44.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"fluent-ffmpeg": "^2.1.3",
		"fs-extra": "^11.3.5",
		"helmet": "^8.2.0",
		"lodash": "^4.18.1",
		"nanoid": "^3.3.15",
		"nodemailer": "^9.0.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.1.3",
		"rxjs": "^7.8.2",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@nestjs/cli": "^11.0.23",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.27",
		"@types/cookie-parser": "^1.4.9",
		"@types/express": "^5.0.6",
		"@types/fluent-ffmpeg": "^2.1.28",
		"@types/fs-extra": "^11.0.4",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.24",
		"@types/multer": "^2.1.0",
		"@types/node": "^26.0.1",
		"@types/nodemailer": "^7.0.4",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^7.2.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.7.0",
		"jest": "^30.4.2",
		"prettier": "^3.8.4",
		"prettier-plugin-prisma": "^5.0.0",
		"prisma": "^7.8.0",
		"react-email": "^6.6.5",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.11",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
