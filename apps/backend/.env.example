# DEV .env для backend (локальный запуск через `bun run dev`)
# БД поднимается через `docker compose -f docker-compose.dev.yml up -d` (postgres/postgres)

PORT=4200
NODE_ENV="development"

JWT_SECRET="change_me_dev_secret"

# Спецсимволы в пароле (@ : / ? # и т.д.) ОБЯЗАТЕЛЬНО URL-кодировать!
# Пример с паролем по умолчанию dev-compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adamix?schema=public"

# Публичный URL клиента — для CORS
CLIENT_URL="http://localhost:3000"

# Публичный URL самого backend — для ссылок в письмах (верификация почты)
API_URL="http://localhost:4200"

RECAPTCHA_SECRET_KEY=

# Email (Mailgun и т.п.)
SMTP_PASSWORD=
SMTP_SERVER=smtp.mailgun.org
SMTP_LOGIN=
