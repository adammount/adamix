# DEV .env для frontend (локальный запуск через `bun run dev`)

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Адрес API backend (с /api на конце). Можно опустить — есть фоллбэк на http://localhost:4200/api
NEXT_PUBLIC_API_URL=http://localhost:4200/api
# Адрес backend для серверных rewrites (/uploads/*) и SSR
SERVER_URL=http://localhost:4200
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
JWT_SECRET="change_me_dev_secret"
