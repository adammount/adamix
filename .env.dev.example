# ============================================================
#  DEV переменные для docker-compose.dev.yml (только Postgres)
#  Скопируй в .env: cp .env.dev.example .env
#  (можно не создавать — есть значения по умолчанию postgres/postgres/adamix)
#
#  Сами приложения в dev запускаются локально (bun run dev)
#  и читают свои apps/backend/.env и apps/frontend/.env
# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adamix
